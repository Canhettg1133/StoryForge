VITE_PROXY_URL=https://your-proxy-url.com
VITE_AI_STUDIO_RELAY_URL=https://storyforge-ai-studio-relay.canhettg113.workers.dev
VITE_AI_STUDIO_CONNECTOR_URL=https://ai.studio/apps/685f3deb-17d8-4197-9733-a8f144543129
VITE_ADMIN_API_BASE_URL=http://localhost:8788
VITE_JOB_SERVER_URL=http://localhost:3847
VITE_SHOW_LABS=false
VITE_SHOW_ROADMAP_PAGES=false
VITE_SHOW_JOB_UI=false
VITE_SHOW_WRITING_DEBUG=false
VITE_ENABLE_CLOUD_SYNC=true
VITE_ENABLE_CLOUD_SNAPSHOT_V2=true
VITE_CLOUD_SYNC_API_URL=https://storyforge-cloud-sync.your-account.workers.dev
VITE_CLOUD_SYNC_STORAGE_MODE=hybrid
VITE_ENABLE_STORY_BUNDLE=true
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_STORY_MIRROR=false
VITE_STORY_MIRROR_BASE_URL=https://storyforge-story-mirror.your-account.workers.dev

# Admin API Worker and Vercel access API. Configure SUPABASE_SERVICE_ROLE_KEY
# as a wrangler secret for the worker and a Vercel Production env var for /api/me/access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=never-commit-real-service-role-key
ADMIN_ALLOWED_ORIGINS=http://localhost:5176,https://admin.your-domain.example

# Secure Supreme prompt runtime. Generate a unique 32-byte key and Base64-encode it.
# Keep the real value only in Vercel/Cloudflare/Admin Worker secret storage.
SUPREME_PROMPT_ACTIVE_KEY_VERSION=1
SUPREME_PROMPT_ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-secret
