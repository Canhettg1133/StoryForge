{
    "fluid": true,
    "functions": {
        "api/openai-proxy.js": {
            "maxDuration": 300
        },
        "api/cloudflare-workers-ai.js": {
            "maxDuration": 300
        },
        "api/translator-openai-proxy.js": {
            "maxDuration": 300
        }
    },
    "rewrites": [
        {
            "source": "/((?!api/|translator-runtime/|src/|@react-refresh|@vite/|node_modules/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}
