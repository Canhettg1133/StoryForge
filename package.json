{
  "name": "storyforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:cloudflare": "node scripts/cloudflare-command.mjs dev preview",
    "dev:admin": "vite --config apps/admin/vite.config.js --host 0.0.0.0 --port 5176",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-postgres.ps1",
    "backend:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-backend.ps1",
    "jobs:server": "node src/services/jobs/server.js",
    "zalo:login": "openzca auth login",
    "zalo:status": "openzca auth status",
    "zalo:server": "node tools/zalo-local-server/server.mjs",
    "zalo:dev": "node tools/zalo-local-server/server.mjs --open",
    "dev:zalo": "npm run zalo:dev",
    "analysis:eval:live": "node scripts/analysis-live-eval.mjs",
    "benchmark:translator-chapters": "node --expose-gc scripts/benchmark-translator-chapters.mjs --sizes=5,20,50 --epub",
    "benchmark:translator-han-file": "node --expose-gc scripts/benchmark-translator-han-file.mjs --sizes=5,20,50",
    "migrate:cloud-sync-r2": "node scripts/cloud-sync-r2-backfill.mjs",
    "reconcile:cloud-sync-r2": "node scripts/cloud-sync-r2-reconcile.mjs",
    "smoke:cloud-sync-r2": "node scripts/cloud-sync-http-smoke.mjs",
    "test": "vitest run",
    "test:core": "vitest run src/tests/utils/characterIdentity.test.js src/tests/phases/phase10-projectContentModeStore.test.js src/tests/phases/phase10-canonEngine.test.js src/tests/phases/phase10-promptBuilder.test.js src/tests/access/accessControl.test.js src/tests/security/securityHeadersStatic.test.js",
    "test:cloudflare-runtime": "vitest run --config vitest.cloudflare.config.js",
    "test:cloud-sync-postgres": "node scripts/cloud-sync-postgres-integration.mjs",
    "test:admin-postgres": "node scripts/admin-mutations-postgres-integration.mjs",
    "test:admin": "vitest run src/tests/phases/phase12-adminAccess.test.js src/tests/phases/phase12-adminApiWorker.test.js",
    "test:phase6b": "vitest run src/tests/phases/phase6b-incidentFirst.test.js",
    "test:phase6d": "vitest run src/tests/phases/phase6d-analysisV2.test.js",
    "test:phase6f": "vitest run src/tests/phases/phase6f-analysisLiveEval.test.js",
    "build": "node scripts/build-production-app.mjs user",
    "build:plain": "vite build",
    "build:secure": "node scripts/build-production-app.mjs user",
    "build:admin": "node scripts/build-production-app.mjs admin",
    "build:admin:plain": "vite build --config apps/admin/vite.config.js",
    "build:admin:secure": "node scripts/build-production-app.mjs admin",
    "build:cloudflare:preview": "node scripts/cloudflare-command.mjs build preview",
    "build:cloudflare:production": "node scripts/cloudflare-command.mjs build production",
    "preview": "vite preview",
    "preview:admin": "vite preview --config apps/admin/vite.config.js --host 0.0.0.0 --port 4176",
    "preview:cloudflare": "node scripts/cloudflare-command.mjs preview preview",
    "worker:user:dry-run:preview": "node scripts/cloudflare-command.mjs dry-run preview",
    "worker:user:dry-run:production": "node scripts/cloudflare-command.mjs dry-run production",
    "deploy:cloudflare:preview": "node scripts/cloudflare-command.mjs deploy preview",
    "deploy:cloudflare:production": "node scripts/cloudflare-command.mjs deploy production",
    "worker:admin:dry-run": "npx wrangler deploy --config apps/admin-api-worker/wrangler.toml --dry-run",
    "worker:relay:dry-run": "npx wrangler deploy --config relay-worker/wrangler.toml --dry-run",
    "worker:story-mirror:dry-run": "npx wrangler deploy --config apps/story-mirror-worker/wrangler.toml --dry-run",
    "worker:cloud-sync:dry-run": "npx wrangler deploy --config apps/cloud-sync-worker/wrangler.toml --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-character-count": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "comlink": "^4.4.2",
    "cors": "^2.8.6",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.10",
    "file-saver": "^2.0.5",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "linkify-it": "^5.0.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "openzca": "^0.1.59",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.35.2",
    "ws": "^8.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@cloudflare/vite-plugin": "1.45.0",
    "@cloudflare/vitest-pool-workers": "0.18.5",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^29.0.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.2",
    "wrangler": "4.111.0"
  }
}
